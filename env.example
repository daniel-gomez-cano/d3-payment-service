# ================================================
# Variables de entorno del payment-service
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio (ya está en .gitignore).
# ================================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/paymentdb
DB_DRIVER=org.postgresql.Driver
DB_USER=payment_user
DB_PASSWORD=payment_pass

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/viva-eventos

# ---- MercadoPago ----
# Obtén tu Access Token en: https://www.mercadopago.com.co/developers/panel
# Usa el "Access Token de prueba" para sandbox.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_SANDBOX=true

# Clave secreta para validar firmas HMAC de los webhooks de MercadoPago.
# En el panel de MP, ve a Tu integración → Webhooks → configura la clave.
MP_WEBHOOK_SECRET=tu-clave-secreta-del-webhook-mercadopago

# URL pública donde MercadoPago enviará las notificaciones.
# En desarrollo local usa ngrok: ngrok http 8084
# y pon aquí la URL que te da ngrok, p.ej: https://abc123.ngrok-free.app/api/payments/webhook/mercadopago
MP_NOTIFICATION_URL=https://tu-dominio.com/api/payments/webhook/mercadopago

# URLs a donde MP redirige al comprador después del pago
MP_BACK_URL_SUCCESS=http://localhost:3000/checkout/success
MP_BACK_URL_FAILURE=http://localhost:3000/checkout/failure
MP_BACK_URL_PENDING=http://localhost:3000/checkout/pending

# URL del order-service
ORDER_SERVICE_URL=http://localhost:8083
